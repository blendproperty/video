# Copy this to .env and fill in real values before running the app.

# This path is inside the container, mounted from ./data/db on the host
# (see docker-compose.yml) so the database survives rebuilds/restarts.
DATABASE_URL="file:/data/dev.db"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Used once by `npm run db:seed` to create the first login. Change the
# password immediately after first login, then you can remove these two
# lines from .env (they're only read by the seed script).
ADMIN_EMAIL="you@blendproperty.co.za"
ADMIN_PASSWORD="change-me-immediately"

# Optional: lets the "New property video" wizard pull listings straight from
# listings.blendproperty.co.za (details + photos) instead of manual entry.
# Generate LISTINGS_API_KEY in that app's /dashboard/integrations page (any
# active scope works — this endpoint doesn't do portfolio filtering). If
# these two are left blank, the wizard just skips straight to manual entry.
LISTINGS_API_URL="https://listings.blendproperty.co.za"
LISTINGS_API_KEY=""
