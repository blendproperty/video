# Copy this to .env and fill in real values before running the app.

DATABASE_URL="file:./prisma/dev.db"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Used once by `npm run db:seed` to create the first login. Change the
# password immediately after first login, then you can remove these two
# lines from .env (they're only read by the seed script).
ADMIN_EMAIL="you@blendproperty.co.za"
ADMIN_PASSWORD="change-me-immediately"
