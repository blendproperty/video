# Read by docker-compose.yml (NOT the same file as web/.env, which holds
# the app's own secrets). Copy this to .env in the repo root.

# The public domain the shared Traefik instance (container "root-traefik-1")
# will route to this app. Must already point at this server's IP via a DNS
# A record — that record was set up separately from this app's deployment.
DOMAIN=video.onpointoffices.co.za
