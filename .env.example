# Read by docker-compose.yml (NOT the same file as web/.env, which holds
# the app's own secrets). Copy this to .env in the repo root.

# The public domain Traefik will route to the video-portal container and
# request a Let's Encrypt certificate for. Must already point at this
# server's IP via a DNS A record before you bring Traefik up, or the
# certificate request will fail.
DOMAIN=video.onpointoffices.co.za

# Let's Encrypt sends renewal/expiry notices here. Any address you check.
ACME_EMAIL=brettd@blendproperty.co.za
